{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,
    "moduleResolution": "Node16",

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "resolveJsonModule": true,

    "declaration": true,

    "sourceMap": true,

    "types": ["node"]
  },

  "include": ["src"],

  "exclude": [
    "node_modules",
    "dist"
  ]
}
